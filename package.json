{
  "name": "mmm-buttons",
  "version": "2.1.0",
  "description": "A module for connecting multiple buttons.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jopyth/MMM-Buttons"
  },
  "type": "commonjs",
  "keywords": [
    "MagicMirror",
    "module",
    "buttons",
    "GPIO",
    "notifications"
  ],
  "author": "Joseph Bethge",
 	"contributors": [
		{
			"name": "Contributors",
			"url": "https://github.com/jopyth/MMM-Buttons/graphs/contributors"
		}
	],
  "license": "MIT",
  "bugs": {
    "url": "git+https://github.com/jopyth/MMM-Buttons/issues"
  },
  "homepage": "https://github.com/jopyth/MMM-Buttons#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.5.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^12.6.1",
    "cspell": "^9.7.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "lint-staged": "^16.3.2",
    "simple-git-hooks": "^2.13.1"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "simple-git-hooks || true",
    "spellcheck": "cspell --no-progress \"**/*\"",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix"
    ]
  }
}
